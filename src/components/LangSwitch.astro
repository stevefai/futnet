---
import { getUi } from '../content';
import { assetUrl } from '../lib/format';
import type { Lang } from '../lib/types';

interface Props {
  lang: Lang;
  size?: 'xs' | 'sm';
}

const { lang, size = 'sm' } = Astro.props;
const t = getUi(lang);
const sizeClass = size === 'xs' ? 'btn-xs min-w-10' : 'btn-sm min-w-11';
const on = 'bg-primary-content text-primary hover:bg-primary-content';
const off = 'btn-ghost text-primary-content';
---

<div class="join border border-primary-content/40 rounded-lg" role="group" aria-label={t.language}>
  <a
    href={assetUrl('')}
    data-lang-link="it"
    aria-current={lang === 'it' ? 'true' : undefined}
    class:list={['btn join-item border-0', sizeClass, lang === 'it' ? on : off]}>IT</a
  >
  <a
    href={assetUrl('en/')}
    data-lang-link="en"
    aria-current={lang === 'en' ? 'true' : undefined}
    class:list={['btn join-item border-0', sizeClass, lang === 'en' ? on : off]}>EN</a
  >
</div>
