---
import { contactPaths, getUi, site } from '../content';
import { assetUrl } from '../lib/format';
import type { Lang } from '../lib/types';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Lang;
  page?: 'home' | 'contact';
}

const { lang, page = 'home' } = Astro.props;
const t = getUi(lang);
const itPath = page === 'contact' ? contactPaths.it : '';
const enPath = page === 'contact' ? contactPaths.en : 'en/';
const homePath = lang === 'it' ? '' : 'en/';
const home = assetUrl(homePath);
const links = [
  { href: `${home}#feed`, label: t.navFeed, current: false },
  { href: `${home}#story`, label: t.navStory, current: false },
  { href: `${home}#gallery`, label: t.navGallery, current: false },
  { href: `${home}#players`, label: t.navPlayers, current: false },
  { href: assetUrl(contactPaths[lang]), label: t.navContact, current: page === 'contact' },
];
---

<header class="sticky top-0 z-20 border-b-4 border-gold bg-primary text-primary-content">
  <div class="mx-auto flex max-w-[1200px] items-center justify-between gap-4 px-5 py-2.5 md:px-10 md:py-3">
    <a href={home} class="flex items-center gap-3">
      <img src={assetUrl(site.logo)} alt={t.logoAlt} class="h-11 w-auto md:h-14" />
      <span class="font-display text-xl font-bold uppercase leading-[1.05] tracking-wide md:text-[26px]">
        Futnet<br />Italia
      </span>
    </a>

    <!-- desktop -->
    <nav class="hidden items-center gap-5 whitespace-nowrap text-[16px] font-medium md:flex lg:gap-7 lg:text-[17px]" aria-label="Main">
      {
        links.map((l) => (
          <a href={l.href} aria-current={l.current ? 'page' : undefined} class:list={['text-primary-content/80 hover:text-primary-content', l.current && 'font-semibold !text-primary-content underline decoration-secondary decoration-2 underline-offset-8']}>
            {l.label}
          </a>
        ))
      }
      <LangSwitch lang={lang} size="sm" itPath={itPath} enPath={enPath} />
    </nav>

    <!-- phone -->
    <div class="flex items-center gap-2.5 md:hidden">
      <LangSwitch lang={lang} size="xs" itPath={itPath} enPath={enPath} />
      <details class="dropdown dropdown-end" data-nav-menu>
        <summary class="btn btn-square btn-ghost border border-primary-content/40 text-primary-content" aria-label={t.menu}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <ul class="menu dropdown-content z-30 mt-3 w-64 rounded-box bg-primary p-2 text-primary-content shadow-lg">
          {
            links.map((l) => (
              <li>
                <a href={l.href} aria-current={l.current ? 'page' : undefined} class:list={['py-3 text-base', l.current && 'font-semibold']}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </div>
</header>
