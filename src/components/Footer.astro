---
import { getText, getUi, team } from '../content';
import { assetUrl } from '../lib/format';
import type { Lang } from '../lib/types';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);
const copy = getText(lang);
const year = new Date().getFullYear();

const links = [
  team.contact.email ? { label: team.contact.email, href: `mailto:${team.contact.email}`, external: false } : null,
  team.contact.facebook ? { label: 'Facebook', href: team.contact.facebook, external: true } : null,
  team.contact.instagram ? { label: 'Instagram', href: team.contact.instagram, external: true } : null,
].filter((l): l is { label: string; href: string; external: boolean } => l !== null);
---

<footer id="contact" class="border-t-4 border-secondary bg-primary text-primary-content">
  <div class="mx-auto max-w-[1200px] px-5 pb-8 pt-10 md:px-10 md:pt-16">
    <div class="flex flex-wrap gap-x-16 gap-y-10">
      <div class="flex min-w-0 flex-[1_1_320px] items-center gap-5">
        <img src={assetUrl('crest.png')} alt={t.crestAlt} class="h-[72px] w-auto md:h-24" />
        <div>
          <p class="font-display text-[30px] font-bold uppercase leading-none tracking-wide md:text-[34px]">{team.name}</p>
          <p class="mt-2 text-primary-content/80">{copy.footerLine}</p>
        </div>
      </div>

      {
        links.length > 0 && (
          <div class="min-w-0 flex-[1_1_240px]">
            <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-primary-content/80">{t.contact}</h2>
            <ul class="mt-3 flex flex-col gap-2">
              {links.map((l) => (
                <li>
                  <a href={l.href} class="text-primary-content/80 hover:text-primary-content hover:underline" target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener noreferrer' : undefined}>
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>

    <p class="mt-8 text-[15px] text-primary-content/70">© {year} {team.name}</p>
  </div>
</footer>
