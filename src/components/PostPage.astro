---
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { getUi, postPath, site } from '../content';
import { assetUrl, formatDate } from '../lib/format';
import { newsImage } from '../lib/news-images';
import { blocksToHtml } from '../lib/rich';
import type { Lang, Post } from '../lib/types';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  lang: Lang;
  post: Post;
}

const { lang, post } = Astro.props;
const t = getUi(lang);
const isEvent = post.type === 'event';
const image = newsImage(post.image);
// the whole picture is shown (posters carry their own text); the big version opens full screen
const shown = image ? await getImage({ src: image, width: 900 }) : null;
const full = image ? await getImage({ src: image, width: 2000 }) : null;
const html = blocksToHtml(post.body[lang]);
const posted = post.posted ? formatDate(post.posted, lang, { day: 'numeric', month: 'long', year: 'numeric' }) : '';
const date = post.eventDate ? formatDate(post.eventDate, lang, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) : '';
const details = [date, post.eventTime, post.place].filter(Boolean);

let isFacebook = false;
try {
  const host = new URL(post.link).hostname.toLowerCase();
  isFacebook = host.endsWith('facebook.com') || host === 'fb.me' || host.endsWith('fb.com');
} catch {
  isFacebook = false;
}
const actionLabel = isFacebook ? t.viewFacebook : t.moreInfo;
const back = assetUrl(lang === 'it' ? 'novita/' : 'en/news/');
const itPath = postPath('it', post.slug.it);
const enPath = postPath('en', post.slug.en);
---

<Layout lang={lang} title={post.title[lang]} itPath={itPath} enPath={enPath}>
  <Header lang={lang} page="news" itPath={itPath} enPath={enPath} />
  <main>
    <article>
      {
        /* without a picture the top of the page is a navy header that carries the title and the event details */
        !image && (
          <header class="post-head" style={`--logo:url(${assetUrl(site.logo)})`}>
            <div class="mx-auto max-w-[800px] px-5 py-8 md:px-10 md:py-12">
              <a href={back} class="btn btn-ghost -ml-3 mb-4 text-primary-content/80 hover:bg-primary-content/10 hover:text-primary-content">← {t.postBack}</a>
              <div class="flex flex-wrap items-center gap-3">
                <span class:list={['badge font-semibold uppercase tracking-wider', isEvent ? 'badge-secondary' : 'border-primary-content/40 bg-primary-content/15 text-primary-content']}>
                  {isEvent ? t.tagEvent : t.tagNews}
                </span>
                {posted && <span class="text-[15px] font-semibold text-primary-content/75">{t.posted} {posted}</span>}
              </div>
              <h1 class="mt-3 font-display text-[40px] font-bold uppercase leading-[1.02] md:text-[60px]">{post.title[lang]}</h1>
              {
                isEvent && details.length > 0 && (
                  <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-[17px] font-semibold md:text-lg">
                    {details.map((d) => (
                      <li class="flex items-center gap-2">
                        <span class="h-1.5 w-1.5 rounded-full bg-gold" />
                        {d}
                      </li>
                    ))}
                  </ul>
                )
              }
            </div>
          </header>
        )
      }

      <div class:list={['mx-auto px-5 py-10 md:px-10 md:py-14', image ? 'max-w-[1100px]' : 'max-w-[800px]']}>
        {image && <a href={back} class="btn btn-ghost -ml-3 mb-4">← {t.postBack}</a>}

        <div class:list={[image && 'grid gap-8 md:grid-cols-[minmax(0,420px)_minmax(0,1fr)] md:items-start md:gap-12']}>
          {
            shown && full && (
              <figure class="relative md:sticky md:top-24">
                <button type="button" class="block w-full cursor-zoom-in overflow-hidden rounded-box shadow-xl" data-zoom={full.src} aria-label={t.postEnlarge}>
                  <img src={shown.src} alt="" width={shown.attributes.width} height={shown.attributes.height} class="h-auto w-full" />
                </button>
                <span class="pointer-events-none absolute bottom-3 right-3 rounded-md bg-primary/90 px-3 py-1.5 text-sm font-semibold text-primary-content">⤢ {t.postEnlarge}</span>
              </figure>
            )
          }

          <div class="min-w-0">
            {
              image && (
                <>
                  <div class="flex flex-wrap items-center gap-3">
                    <span class:list={['badge font-semibold uppercase tracking-wider', isEvent ? 'badge-secondary' : 'badge-primary']}>
                      {isEvent ? t.tagEvent : t.tagNews}
                    </span>
                    {posted && <span class="text-[15px] font-semibold text-base-content/60">{t.posted} {posted}</span>}
                  </div>
                  <h1 class="mt-3 font-display text-[40px] font-bold uppercase leading-[1.02] md:text-[52px]">{post.title[lang]}</h1>
                  {isEvent && details.length > 0 && (
                    <div class="mt-5 rounded-box border-l-[6px] border-secondary bg-base-100 p-5">
                      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-base-content/60">{t.eventDetails}</p>
                      <ul class="mt-2 space-y-1 text-[17px] font-semibold md:text-lg">
                        {details.map((d) => <li>{d}</li>)}
                      </ul>
                    </div>
                  )}
                </>
              )
            }

            <div class:list={['post-body', image ? 'mt-6' : '']} set:html={html} />

            {
              post.link && (
                <a href={post.link} target="_blank" rel="noopener noreferrer" class="btn btn-primary mt-8">
                  {actionLabel}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17L17 7M8 7h9v9" />
                  </svg>
                </a>
              )
            }
          </div>
        </div>
      </div>
    </article>

    {
      full && (
        <dialog class="m-0 h-full max-h-none w-full max-w-none bg-black/95 p-0 backdrop:bg-black" data-zoom-dialog aria-label={post.title[lang]}>
          <div class="relative flex h-full w-full items-center justify-center" data-zoom-bg>
            <img alt="" class="max-h-full max-w-full object-contain" data-zoom-img />
            <button type="button" class="btn btn-circle btn-ghost absolute right-3 top-3 text-2xl text-white" data-zoom-close aria-label={t.galleryClose}>✕</button>
          </div>
        </dialog>
      )
    }
  </main>
  <Footer lang={lang} />
</Layout>

<script>
  // Full screen view of the post's picture
  const button = document.querySelector<HTMLButtonElement>('[data-zoom]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-zoom-dialog]');
  const img = document.querySelector<HTMLImageElement>('[data-zoom-img]');
  if (button && dialog && img) {
    const close = () => {
      if (dialog.open) dialog.close();
      document.documentElement.style.overflow = '';
    };
    button.addEventListener('click', () => {
      img.src = button.dataset.zoom ?? '';
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
    });
    dialog.querySelector('[data-zoom-close]')?.addEventListener('click', close);
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || (e.target as HTMLElement).hasAttribute('data-zoom-bg')) close();
    });
    dialog.addEventListener('close', close);
  }
</script>
