---
import { getUi } from '../content';
import { assetUrl, formatDate } from '../lib/format';
import type { Lang, Post } from '../lib/types';

interface Props {
  post: Post;
  lang: Lang;
  /** true = hidden until "Show older posts" is pressed */
  extra?: boolean;
}

const { post, lang, extra = false } = Astro.props;
const t = getUi(lang);
const isEvent = post.type === 'event';
const title = post.title[lang];
const body = post.text[lang];

const when = [
  post.eventDate ? formatDate(post.eventDate, lang, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) : '',
  post.eventTime,
  post.place,
]
  .filter(Boolean)
  .join(' · ');

const posted = post.posted ? formatDate(post.posted, lang, { day: 'numeric', month: 'long', year: 'numeric' }) : '';
const badgeDay = post.eventDate ? formatDate(post.eventDate, lang, { day: 'numeric' }) : '';
const badgeMonth = post.eventDate ? formatDate(post.eventDate, lang, { month: 'short' }).replace('.', '') : '';

let isFacebook = false;
try {
  const host = new URL(post.link).hostname.toLowerCase();
  isFacebook = host.endsWith('facebook.com') || host === 'fb.me' || host.endsWith('fb.com');
} catch {
  isFacebook = false;
}
const actionLabel = isEvent ? (isFacebook ? t.viewFacebook : t.moreInfo) : t.readMore;
const fallback = assetUrl('poster-fallback.svg');
---

<article class="flex items-start gap-3.5 overflow-hidden rounded-box bg-base-100 p-3 sm:gap-0 sm:p-0" data-extra={extra ? '' : undefined}>
  {
    post.poster && (
      <div class="relative aspect-[3/4] w-24 shrink-0 overflow-hidden rounded-lg bg-base-300 sm:w-60 sm:rounded-none">
        <img
          src={post.poster}
          alt=""
          loading="lazy"
          referrerpolicy="no-referrer"
          class="h-full w-full object-cover"
          onerror={`this.onerror=null;this.src='${fallback}'`}
        />
        {isEvent && badgeDay && (
          <div class="absolute left-1.5 top-1.5 rounded-md bg-secondary px-2 py-0.5 text-center font-display font-bold leading-none text-secondary-content sm:left-4 sm:top-4 sm:px-3 sm:py-1.5">
            <span class="block text-xl sm:text-3xl">{badgeDay}</span>
            <span class="block text-[11px] uppercase tracking-widest sm:text-base">{badgeMonth}</span>
          </div>
        )}
      </div>
    )
  }

  <div class="flex min-w-0 flex-1 flex-col items-start gap-1.5 sm:gap-3 sm:p-7">
    <div class="flex flex-wrap items-center gap-2 sm:gap-3">
      <span class:list={['badge badge-sm font-semibold uppercase tracking-wider sm:badge-md', isEvent ? 'badge-secondary' : 'badge-primary']}>
        {isEvent ? t.tagEvent : t.tagNews}
      </span>
      {posted && (
        <span class="text-[13px] font-semibold text-base-content/60 sm:text-[15px]">
          {t.posted} {posted}
        </span>
      )}
    </div>

    <h3 class="font-display text-[22px] font-bold uppercase leading-[1.05] sm:text-[34px]">{title}</h3>

    {
      isEvent && when && (
        <p class="flex items-start gap-2 text-sm font-semibold sm:text-[17px]">
          <svg class="mt-0.5 shrink-0 text-secondary" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11z" />
            <circle cx="12" cy="10" r="2.5" />
          </svg>
          <span>{when}</span>
        </p>
      )
    }

    {body && <p class="line-clamp-3 whitespace-pre-line break-words text-sm text-[#2A3560] sm:line-clamp-none sm:text-[17px]">{body}</p>}

    {
      post.link && (
        <a
          href={post.link}
          target="_blank"
          rel="noopener noreferrer"
          class:list={['btn', isEvent ? 'btn-primary' : 'btn-ghost text-primary']}>
          {actionLabel}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7M8 7h9v9" />
          </svg>
        </a>
      )
    }
  </div>
</article>
