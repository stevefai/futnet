---
import { getImage } from 'astro:assets';
import { getUi, postPath } from '../content';
import { assetUrl, formatDate } from '../lib/format';
import { newsImage } from '../lib/news-images';
import type { Lang, Post } from '../lib/types';

interface Props {
  post: Post;
  lang: Lang;
  /** true = hidden until "Show older posts" is pressed */
  extra?: boolean;
}

const { post, lang, extra = false } = Astro.props;
const t = getUi(lang);
const isEvent = post.type === 'event';
const title = post.title[lang];
const excerpt = post.excerpt[lang];
const href = assetUrl(postPath(lang, post.slug[lang]));
const image = newsImage(post.image);
// the whole picture is shown (posters carry their own text), so a small file is enough
const thumb = image ? await getImage({ src: image, width: 480 }) : null;

// the details line of an event: weekday, date, time, place
const when = [
  post.eventDate ? formatDate(post.eventDate, lang, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) : '',
  post.eventTime,
  post.place,
]
  .filter(Boolean)
  .join(' · ');
const posted = post.posted ? formatDate(post.posted, lang, { day: 'numeric', month: 'long', year: 'numeric' }) : '';

// the stand-in for a missing picture: the event date, or for news the day it was posted
const dateSource = isEvent && post.eventDate ? post.eventDate : post.posted;
const dayNumber = dateSource ? formatDate(dateSource, lang, { day: '2-digit' }) : '';
const monthShort = dateSource ? formatDate(dateSource, lang, { month: 'short' }).replace('.', '') : '';
const dateLabel = isEvent && post.eventDate ? formatDate(post.eventDate, lang, { weekday: 'long' }) : t.tagNews;
---

<article class="grid overflow-hidden rounded-box bg-base-100 md:grid-cols-[170px_minmax(0,1fr)]" data-extra={extra ? '' : undefined}>
  {
    thumb ? (
      <a href={href} tabindex="-1" aria-hidden="true" class="post-thumb" style={`--src:url(${thumb.src})`}>
        <img src={thumb.src} alt="" width={thumb.attributes.width} height={thumb.attributes.height} loading="lazy" decoding="async" />
      </a>
    ) : (
      <a href={href} tabindex="-1" aria-hidden="true" class:list={['post-date', isEvent ? 'is-event' : 'is-news']}>
        <small>{dateLabel}</small>
        <b>{dayNumber}</b>
        <i>{monthShort}</i>
      </a>
    )
  }

  <div class="flex min-w-0 flex-col items-start gap-2 p-5 md:px-6 md:py-5">
    <div class="flex flex-wrap items-center gap-2.5">
      <span class:list={['badge badge-sm font-semibold uppercase tracking-wider', isEvent ? 'badge-secondary' : 'badge-primary']}>
        {isEvent ? t.tagEvent : t.tagNews}
      </span>
      {posted && <span class="text-[13px] font-semibold text-base-content/60 sm:text-[15px]">{t.posted} {posted}</span>}
    </div>

    <h3 class="font-display text-[26px] font-bold uppercase leading-[1.05] sm:text-[30px]">
      <a href={href} class="hover:text-accent">{title}</a>
    </h3>

    {
      isEvent && when && (
        <p class="flex items-start gap-2 text-[15px] font-semibold sm:text-base">
          <svg class="mt-0.5 shrink-0 text-secondary" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11z" />
            <circle cx="12" cy="10" r="2.5" />
          </svg>
          <span>{when}</span>
        </p>
      )
    }

    {excerpt && <p class="line-clamp-2 break-words text-[15px] text-[#2b4766] sm:text-base">{excerpt}</p>}

    <a href={href} class="btn btn-primary mt-auto">
      {t.readMore}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </a>
  </div>
</article>
